# assembled/ is a derived symlink layer rebuilt by scripts/skills-sync — not tracked.
/assembled/

# upstream clone cache used by scripts/skills-update
/.cache/

# Local coding-agent state (normally stored under ~/.<agent>).
/.claude/
/.codex/
/.pi/
/.copilot/
/.kiro/

# Machine-local aqrp workspace registry: absolute paths that must never reach
# another machine. NB `skills-install --copy` (cp -rL) would still carry it along.
self/coding/aqrp/workspaces.yaml

# Python bytecode
__pycache__/
*.pyc
