#!/usr/bin/env bash
# skills-sync — rebuild the assembled/ symlink layer from vendored/ + self/,
# driven by manifest.tsv. Idempotent. Optionally --update pulls upstreams first.
#
# Usage:
#   skills-sync            rebuild assembled/ from current sources
#   skills-sync --update   update vendored upstreams via skills CLI, then rebuild
#
# Single source of truth = manifest.tsv (pack \t skill \t source[vendored|self]).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # repo root
MANIFEST="$ROOT/manifest.tsv"

if [[ "${1:-}" == "--update" ]]; then
  shift
  echo "==> updating vendored upstreams (self-contained git updater)"
  "$ROOT/scripts/skills-update" "$@" \
    || echo "!! skills-update reported errors — rebuild continues"
fi

echo "==> rebuilding assembled/ from manifest"
packs=$(cut -f1 "$MANIFEST" | sort -u)
for pack in $packs; do rm -rf "$ROOT/assembled/$pack"; mkdir -p "$ROOT/assembled/$pack"; done

n=0
while IFS=$'\t' read -r pack skill src; do
  [[ -n "${pack:-}" && -n "${skill:-}" ]] || continue
  dest="$ROOT/assembled/$pack/$skill"
  case "$src" in
    vendored)
      [[ -d "$ROOT/vendored/$pack/$skill" ]] || { echo "!! missing vendored: $pack/$skill"; continue; }
      ln -sfn "../../vendored/$pack/$skill" "$dest" ;;   # relative → portable within the repo
    self)
      [[ -d "$ROOT/self/$pack/$skill" ]] || { echo "!! missing self: $pack/$skill"; continue; }
      ln -sfn "../../self/$pack/$skill" "$dest" ;;       # relative → portable within the repo
    *) echo "!! unknown source '$src' for $skill"; continue ;;
  esac
  n=$((n+1))
done < "$MANIFEST"

echo "==> assembled $n skills:"
for pack in $packs; do printf "   %-12s %d\n" "$pack" "$(ls "$ROOT/assembled/$pack" | wc -l)"; done
