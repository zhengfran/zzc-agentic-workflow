# assembled/ is a derived symlink layer rebuilt by scripts/skills-sync — not tracked.
/assembled/

# upstream clone cache used by scripts/skills-update
/.cache/

# Local coding-agent state (normally stored under ~/.<agent>).
/.claude/
/.codex/
/.pi/
/.copilot/
/.kiro/

# Python bytecode cache (scripts/skills-update is a py script run in place).
__pycache__/
*.pyc
